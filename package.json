{
  "name": "aether",
  "productName": "Aether",
  "version": "1.0.0",
  "author": "GamingCat9439",
  "description": "A local Lua workspace and executor bridge for Aether",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.aether.desktop",
    "productName": "Aether",
    "publish": {
      "provider": "github",
      "owner": "GamingCat9439",
      "repo": "Aether"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
